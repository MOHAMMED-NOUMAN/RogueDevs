<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions are intentionally left out of this boilerplate.
         Add Bluetooth / Wi-Fi / location / microphone / foreground-service
         permissions when you build the feature that actually needs each
         one — don't front-load permission prompts before there's a
         reason for them. -->

    <!-- Transport: Android refuses to open ANY socket without INTERNET, including the
         phone-to-phone TCP socket over Wi-Fi Direct. The app never contacts the internet;
         the checkOfflineOnly Gradle task fails the build if an HTTP client appears. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ItantraApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Itantra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Itantra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>

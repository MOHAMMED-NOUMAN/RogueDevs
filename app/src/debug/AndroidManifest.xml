<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a second launcher icon, "iTantra transport debug", for testing the
     transport layer between two phones. Release builds don't contain it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Listed first so the merged manifest keeps the main app as the first launcher
             activity; Android Studio's Run starts whichever launcher activity comes first. -->
        <activity android:name=".MainActivity" />

        <activity
            android:name=".debug.TransportDebugActivity"
            android:exported="true"
            android:label="iTantra transport debug"
            android:taskAffinity="com.itantra.app.transportdebug"
            android:theme="@style/Theme.Itantra">
            <!-- Own task: with the app's default affinity, tapping this icon while the main app
                 is open only brings the main app's task back to the front. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
